# Frontend: Firebase Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Frontend: optional AI fallback demo key
VITE_OPENAI_API_KEY=

# Backend: Firebase Admin / token verification
# Zwei klare Modi:
#   1 (Default, Produktion): Geschuetzte Endpunkte verlangen einen
#       "Authorization: Bearer <Firebase ID Token>"-Header und verifizieren ihn
#       via Firebase Admin SDK. Ohne gueltiges Service-Account-Setup -> 503.
#   0 (nur lokale Entwicklung/Tests): Authentifizierung wird komplett
#       deaktiviert. Statt 503 wird ein stabiler Stub-User eingehaengt
#       (siehe DRAWFORM_LOCAL_DEV_UID / DRAWFORM_LOCAL_DEV_EMAIL unten).
#       In Produktion NIEMALS auf 0 setzen.
DRAWFORM_REQUIRE_FIREBASE_AUTH=1
DRAWFORM_FIREBASE_PROJECT_ID=
DRAWFORM_FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternative to *_PATH: raw JSON string of the service account
DRAWFORM_FIREBASE_SERVICE_ACCOUNT_JSON=

# Stub-User fuer DRAWFORM_REQUIRE_FIREBASE_AUTH=0 (lokale Entwicklung/Tests).
# Wird ignoriert, sobald DRAWFORM_REQUIRE_FIREBASE_AUTH=1 ist.
DRAWFORM_LOCAL_DEV_UID=local-dev
DRAWFORM_LOCAL_DEV_EMAIL=dev@drawform.local
