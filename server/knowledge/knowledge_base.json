  "rules": [
    {
      "id": "overall_dimensions_required",
      "feature": "outer_contour",
      "priority": "must",
      "when": { "view_kind": "orthographic" },
      "actions": [
        { "type": "add_dimension", "dimension": "overall_length" },
        { "type": "add_dimension", "dimension": "overall_height" }
      ],
      "source_refs": ["iso_129_1_catalog", "din_iso_baseline_drawform"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "manufacturing_lead"], "last_reviewed": "2026-03-03" }
    },
    {
      "id": "hole_diameter_required",
      "feature": "hole",
      "priority": "must",
      "when": { "visible": true },
      "actions": [
        { "type": "add_dimension", "dimension": "diameter", "format": "Ø {diameter_mm}" }
      ],
      "source_refs": ["iso_129_1_catalog", "golden_samples_review_2026_02"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "qa_lead"], "last_reviewed": "2026-03-03" }
    },
    {
      "id": "hole_location_required",
      "feature": "hole_pattern",
      "priority": "must",
      "when": { "count_min": 2 },
      "actions": [
        { "type": "add_dimension", "dimension": "pitch_or_spacing" },
        { "type": "add_dimension", "dimension": "position_from_datums" }
      ],
      "source_refs": ["iso_129_1_catalog", "din_iso_baseline_drawform"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "metrology_lead"], "last_reviewed": "2026-03-03" }
    },
    {
      "id": "avoid_duplicate_dimensions",
      "feature": "global",
      "priority": "must_not",
      "actions": [
        { "type": "forbid", "dimension": "duplicate_same_information" }
      ],
      "source_refs": ["iso_129_1_catalog", "golden_samples_review_2026_02"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "qa_lead"], "last_reviewed": "2026-03-03" }
    },
    {
      "id": "slot_complete_definition",
      "feature": "slot",
      "priority": "should",
      "actions": [
        { "type": "add_dimension", "dimension": "width" },
        { "type": "add_dimension", "dimension": "length" },
        { "type": "add_dimension", "dimension": "location_from_datums" }
      ],
      "source_refs": ["iso_129_1_catalog", "shopfloor_feedback"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "manufacturing_lead"], "last_reviewed": "2026-03-03" }
    },
    {
      "id": "thread_callout_required",
      "feature": "thread",
      "priority": "must",
      "actions": [
        { "type": "add_callout", "dimension": "thread_designation", "format": "M{nominal_diameter}-{tolerance_class}" }
      ],
      "source_refs": ["iso_261_965_series", "din_iso_baseline_drawform"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "qa_lead"], "last_reviewed": "2026-03-03" }
    },
    {
      "id": "general_tolerance_required",
      "feature": "global",
      "priority": "must",
      "when": { "view_kind": "any" },
      "actions": [
        { "type": "add_annotation", "location": "title_block_or_notes", "format": "Allgemeintoleranzen nach DIN ISO 2768-{format_class}{form_class}" }
      ],
      "note": "Must reference ISO 2768 in title block or annotation field. Format class: f/m/c/v. Form class: H/K/L.",
      "source_refs": ["iso_2768_series", "din_iso_baseline_drawform"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "manufacturing_lead"], "last_reviewed": "2026-03-03" }
    },
    {
      "id": "scale_iso_5455_conformity",
      "feature": "global",
      "priority": "must",
      "actions": [
        { "type": "validate", "parameter": "scale", "allowed_values": ["50:1", "20:1", "10:1", "5:1", "2:1", "1:1", "1:2", "1:5", "1:10", "1:20", "1:50", "1:100"] }
      ],
      "source_refs": ["iso_5455_catalog"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "qa_lead"], "last_reviewed": "2026-03-03" }
    },
    {
      "id": "title_block_iso_7200_completeness",
      "feature": "title_block",
      "priority": "must",
      "actions": [
        { "type": "validate_presence", "fields": ["title", "drawing_no", "revision", "date", "scale", "projection_symbol", "material", "unit", "sheet_size", "company"] }
      ],
      "note": "ISO 7200 mandates: identification zone with title, drawing number, revision index. Supplementary: material, mass, scale, projection method symbol, general tolerance.",
      "source_refs": ["iso_7200_catalog", "din_iso_baseline_drawform"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "qa_lead"], "last_reviewed": "2026-03-03" }
    },
    {
      "id": "projection_symbol_required",
      "feature": "title_block",
      "priority": "must",
      "actions": [
        { "type": "add_symbol", "symbol": "first_angle_projection", "location": "title_block" }
      ],
      "note": "ISO 5456-2 requires the projection method to be indicated by its symbol (truncated cone + circles) in the title block, not just text.",
      "source_refs": ["iso_5456_2_catalog", "iso_7200_catalog"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "manufacturing_lead"], "last_reviewed": "2026-03-03" }
    },
    {
      "id": "line_weight_hierarchy_iso_128",
      "feature": "global",
      "priority": "must",
      "actions": [
        { "type": "validate_line_weights", "hierarchy": {
          "visible_edges": { "type": "continuous_thick", "ratio": 1.0 },
          "hidden_edges": { "type": "dashed_thin", "ratio": 0.5 },
          "center_lines": { "type": "chain_thin", "ratio": 0.35 },
          "dimension_lines": { "type": "continuous_thin", "ratio": 0.35 },
          "extension_lines": { "type": "continuous_thin", "ratio": 0.35 }
        }}
      ],
      "note": "ISO 128-2 defines two line groups: thick (visible edges, cutting planes) and thin (hidden, center, dimension, extension, hatching). Thick:thin ratio = 2:1.",
      "source_refs": ["iso_128_series"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "qa_lead"], "last_reviewed": "2026-03-03" }
    },
    {
      "id": "dimension_outside_contour",
      "feature": "dimension",
      "priority": "must",
      "actions": [
        { "type": "validate_placement", "rule": "outside_part_contour", "min_spacing_mm": 10.0, "inter_dim_spacing_mm": 7.0 }
      ],
      "note": "ISO 129-1: Dimensions shall be placed outside the part outline. First dimension line ≥10mm from contour. Subsequent dimension lines ≥7mm apart.",
      "source_refs": ["iso_129_1_catalog"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "manufacturing_lead"], "last_reviewed": "2026-03-03" }
    },
    {
      "id": "front_view_information_priority",
      "feature": "view_selection",
      "priority": "must",
      "actions": [
        { "type": "select_view", "parameter": "front_view", "rule": "maximize_shape_information" },
        { "type": "prefer", "parameter": "hidden_edge_load", "value": "low" }
      ],
      "note": "Choose the front view that best explains form and principal dimensions. Additional views should improve clarity rather than add hidden-edge clutter.",
      "source_refs": ["din_iso_baseline_drawform", "manufacturing_drawings_literature_review_2026_03"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "manufacturing_lead"], "last_reviewed": "2026-03-17" }
    },
    {
      "id": "additional_views_only_as_needed",
      "feature": "view_selection",
      "priority": "must_not",
      "actions": [
        { "type": "forbid", "parameter": "unnecessary_additional_views" }
      ],
      "note": "Limit orthographic views to the minimum set required for unambiguous definition and complete dimensioning.",
      "source_refs": ["din_iso_baseline_drawform", "manufacturing_drawings_literature_review_2026_03"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "qa_lead"], "last_reviewed": "2026-03-17" }
    },
    {
      "id": "dimension_in_most_descriptive_view",
      "feature": "dimension",
      "priority": "must",
      "actions": [
        { "type": "validate_placement", "rule": "dimension_in_view_of_true_shape" }
      ],
      "note": "Place dimensions in the view where the geometry is most clearly recognizable, not in a secondary or distorted projection.",
      "source_refs": ["iso_129_1_catalog", "manufacturing_drawings_literature_review_2026_03"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "manufacturing_lead"], "last_reviewed": "2026-03-17" }
    },
    {
      "id": "avoid_closed_dimension_chains",
      "feature": "dimension",
      "priority": "must_not",
      "actions": [
        { "type": "forbid", "dimension": "closed_dimension_chain_without_reference" }
      ],
      "note": "Avoid closed dimension chains unless one dimension is explicitly treated as a derived or reference value.",
      "source_refs": ["iso_129_1_catalog", "manufacturing_drawings_literature_review_2026_03"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "qa_lead"], "last_reviewed": "2026-03-17" }
    },
    {
      "id": "repeated_features_need_count_and_pitch",
      "feature": "repeated_feature",
      "priority": "must",
      "actions": [
        { "type": "add_dimension", "dimension": "feature_count" },
        { "type": "add_dimension", "dimension": "pitch_or_spacing" },
        { "type": "add_dimension", "dimension": "total_span_or_pattern_reference" }
      ],
      "note": "Repeated holes, slots, or similar features should be defined by count plus pitch/spacing and a clear reference or total span.",
      "source_refs": ["iso_129_1_catalog", "manufacturing_drawings_literature_review_2026_03"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "metrology_lead"], "last_reviewed": "2026-03-17" }
    },
    {
      "id": "section_views_hide_hidden_edges",
      "feature": "section_view",
      "priority": "must_not",
      "actions": [
        { "type": "forbid", "render": "hidden_edges_in_section" }
      ],
      "note": "Do not show hidden edges in section views unless they are necessary to explain a function-critical condition.",
      "source_refs": ["iso_128_series", "manufacturing_drawings_literature_review_2026_03"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "qa_lead"], "last_reviewed": "2026-03-17" }
    },
    {
      "id": "longitudinal_section_exclusions",
      "feature": "section_view",
      "priority": "must_not",
      "actions": [
        { "type": "forbid", "render": "longitudinal_section_for_shafts_fasteners_ribs" }
      ],
      "note": "Do not section shafts, bolts, screws, pins, ribs, or similar elements longitudinally in normal cases.",
      "source_refs": ["iso_128_series", "manufacturing_drawings_literature_review_2026_03"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "manufacturing_lead"], "last_reviewed": "2026-03-17" }
    },
    {
      "id": "front_view_tie_break_function_before_axis_order",
      "feature": "view_selection",
      "priority": "should",
      "actions": [
        { "type": "prefer", "parameter": "functional_surface_visibility", "value": "high" },
        { "type": "prefer", "parameter": "machining_or_mounting_face_as_front", "value": true },
        { "type": "tie_break", "parameter": "front_view", "rule": "functional_before_default_axis_order" }
      ],
      "note": "If candidate front views explain the shape equally well, prefer the one that exposes functional, machining, or mounting faces before falling back to a generic axis-order tie-break.",
      "source_refs": ["din_iso_baseline_drawform", "manufacturing_drawings_literature_review_2026_03"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "manufacturing_lead"], "last_reviewed": "2026-03-18" }
    },
    {
      "id": "section_preferred_over_hidden_edge_clutter",
      "feature": "section_view",
      "priority": "should",
      "actions": [
        { "type": "prefer", "parameter": "representation", "value": "section_or_partial_section" },
        { "type": "prefer", "parameter": "decision_basis", "value": "internal_clarity_over_hidden_edges" }
      ],
      "note": "When an auxiliary view would mainly consist of hidden edges, prefer a full, half, or partial section that explains the interior more clearly.",
      "source_refs": ["iso_128_series", "manufacturing_drawings_literature_review_2026_03"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "qa_lead"], "last_reviewed": "2026-03-18" }
    },
    {
      "id": "hole_pattern_prefer_coordinate_dimensioning",
      "feature": "hole_pattern",
      "priority": "should",
      "actions": [
        { "type": "prefer", "dimension": "position_from_datums" },
        { "type": "prefer", "dimension": "pitch_or_spacing" },
        { "type": "forbid", "dimension": "pairwise_chain_dimensioning_for_pattern" }
      ],
      "note": "Dense or repeated hole patterns should be tied back to datums and pitch references instead of being defined by pairwise chain dimensions.",
      "source_refs": ["iso_129_1_catalog", "manufacturing_drawings_literature_review_2026_03"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "metrology_lead"], "last_reviewed": "2026-03-18" }
    },
    {
      "id": "dimension_density_requires_layout_escalation",
      "feature": "drawing_layout",
      "priority": "must",
      "actions": [
        { "type": "prefer", "parameter": "dimension_distribution", "value": "split_across_views_before_crowding" },
        { "type": "escalate", "parameter": "layout", "value": "detail_view_scale_or_sheet_upgrade" },
        { "type": "forbid", "parameter": "dimension_overcrowding", "value": true }
      ],
      "note": "If dimensions no longer fit clearly, the drawing must escalate by redistributing dimensions, adding detail views, adjusting scale, or moving to a larger sheet rather than compressing the same view further.",
      "source_refs": ["iso_129_1_catalog", "iso_5455_catalog", "iso_5457_catalog", "manufacturing_drawings_literature_review_2026_03"],
      "quality": { "status": "approved", "reviewers": ["design_lead", "qa_lead"], "last_reviewed": "2026-03-18" }
    },
    {
